#!/bin/bash

unit=ollama-adaptive.service

case "$1" in
	start)
		systemd-run --user --quiet --collect --unit=ollama-adaptive \
			"$HOME/.local/bin/adaptive-gpu" compute /usr/bin/ollama serve
		;;
	stop)
		systemctl --user stop "$unit"
		;;
	restart)
		systemctl --user stop "$unit" 2>/dev/null || true
		systemd-run --user --quiet --collect --unit=ollama-adaptive \
			"$HOME/.local/bin/adaptive-gpu" compute /usr/bin/ollama serve
		;;
	status)
		systemctl --user status "$unit"
		;;
	*)
		printf 'Usage: %s {start|stop|restart|status}\n' "$0" >&2
		exit 2
		;;
esac
